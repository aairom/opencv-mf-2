# =============================================================================
# .gitignore — Generalized Fast Color Clustering (opencv-mf-2)
# IBM Patent US 11,763,422 B2 / Python data-science project
# Generated and enforced by the git-hygiene skill.
# =============================================================================


# =============================================================================
# PYTHON
# =============================================================================

# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.eggs/
*.egg-info/
*.egg
dist/
build/
wheels/
sdist/
*.whl

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
nosetests.xml

# Mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*.ipynb

# IPython
profile_default/
ipython_config.py

# PEP 582 (pdm)
__pypackages__/

# Celery
celerybeat-schedule
celerybeat.pid

# Spyder
.spyderproject.db
.spyproject

# Rope
.ropeproject


# =============================================================================
# VIRTUAL ENVIRONMENTS
# =============================================================================

.venv/
venv/
env/
ENV/
.env/
.venv*/


# =============================================================================
# SECRETS & ENVIRONMENT CONFIGURATION
# =============================================================================

.env
.env.*
# Keep the documented example:
!.env.example


# =============================================================================
# DEPENDENCY MANAGERS
# =============================================================================

# pip
pip-log.txt
pip-delete-this-directory.txt

# uv
uv.lock

# Poetry
poetry.lock

# Pipenv
Pipfile.lock

# node / npm (not primary here, but cover tool scripts)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json


# =============================================================================
# BUILD & BINARY ARTEFACTS
# =============================================================================

*.onnx
