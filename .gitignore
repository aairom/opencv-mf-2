*.bin
*.safetensors


# =============================================================================
# INPUT / OUTPUT FOLDERS
# output/ is fully tracked - all generated plots and reports are committed.
# =============================================================================

# Input documents (keep folder via .gitkeep; content is local/private)
input/*
!input/.gitkeep



# =============================================================================
# UNDERSCORE-PREFIXED FOLDERS
# Convention: _folder/ = private / generated / local-only data
# =============================================================================

_*/


# =============================================================================
# IDE & EDITOR CONFIGURATION
# =============================================================================

# VS Code (keep shared settings if any; ignore personal/local overrides)
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
.vscode/*.code-workspace

# JetBrains (PyCharm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*~
Session.vim
.netrwhist

# Emacs
*#
.#*
\#*#


